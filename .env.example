# ========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values (never commit .env to git!)
# 3. Keep .env in .gitignore (already configured)
# 
# SECURITY NOTES:
# - Never commit .env files containing real credentials
# - Use strong, unique passwords for each environment
# - Consider AWS Secrets Manager for production credentials
# - Rotate passwords immediately if ever exposed
# 
# ========================================

# ========================================
# Database Configuration
# ========================================

# Production RDS Database (AWS with IAM Authentication)
# Note: When using IAM auth, no password is needed in the connection string
# The application generates temporary auth tokens automatically
# Format: postgresql://[USERNAME]@[RDS_ENDPOINT]:[PORT]/[DATABASE]?schema=public
# Example: postgresql://dbadmin@job-analyzer-postgres.xxxxx.us-east-1.rds.amazonaws.com:5432/jobanalyzer?schema=public
DATABASE_URL="postgresql://[USERNAME]@[RDS_ENDPOINT]:5432/[DATABASE]?schema=public"

# RDS Connection Details (for IAM authentication)
RDS_HOST=[RDS_ENDPOINT]
RDS_PORT=5432
RDS_DATABASE=[DATABASE]
RDS_USERNAME=[USERNAME]
# RDS_PASSWORD is NOT needed when using IAM authentication

# ========================================
# Local Development Database
# ========================================
# 
# For local development, create .env.local with:
# DATABASE_URL="postgresql://[USERNAME]:[PASSWORD]@localhost:5434/[DATABASE]"
# 
# Example with placeholder values:
# DATABASE_URL="postgresql://dbadmin:your_local_password@localhost:5434/jobanalyzer"
# 
# Port 5434 is used to avoid conflicts with system PostgreSQL (5432) and test database (5433)

# ========================================
# Test Database Configuration
# ========================================
# 
# For integration tests, create .env.test with:
# DATABASE_URL="postgresql://[USERNAME]:[PASSWORD]@localhost:5433/[DATABASE]"
# 
# Example with placeholder values:
# DATABASE_URL="postgresql://testuser:your_test_password@localhost:5433/jobanalyzer_test"
# 
# Test database uses port 5433 and is ephemeral (data deleted on stop)

# ========================================
# AWS Configuration (CloudFormation)
# ========================================
# IMPORTANT: Never commit this file to git
# Create these values from CloudFormation stack outputs (infra/cloudformation/iam-setup.yml)

# AWS Credentials (from CloudFormation stack outputs)
AWS_ACCESS_KEY_ID=[YOUR_ACCESS_KEY_ID]
AWS_SECRET_ACCESS_KEY=[YOUR_SECRET_ACCESS_KEY]
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=[YOUR_ACCOUNT_ID]

# CloudFormation Stack Information
CF_STACK_NAME=job-analyzer-iam
CF_ENVIRONMENT=job-analyzer

# S3 Configuration (populated after Task 4)
S3_BUCKET_NAME=[YOUR_S3_BUCKET_NAME]
S3_REGION=us-east-1

# App Runner (populated after Task 10)
APP_RUNNER_SERVICE_ARN=[YOUR_APP_RUNNER_SERVICE_ARN]

# ========================================
# Firebase Configuration
# ========================================
# Firebase service account (server). This is a JSON object or a path to a JSON file with service account credentials.
# Example: FIREBASE_SERVICE_ACCOUNT='{ "type": "service_account", ... }' or FIREBASE_SERVICE_ACCOUNT=/path/to/firebase-key.json
FIREBASE_SERVICE_ACCOUNT=[YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_OR_PATH]

# Firebase client configuration (public; client-side)
# Run `firebase init` in your project and paste the corresponding values here

# ========================================
# LLM API Configuration
# ========================================

# Google Gemini
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
GEMINI_MODEL=gemini-pro

# OpenAI
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
OPENAI_MODEL=gpt-3.5-turbo

# Other LLM Provider
OTHER_LLM_API_KEY=[YOUR_OTHER_LLM_API_KEY]
OTHER_LLM_MODEL=model-name

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
NUXT_PUBLIC_API_BASE=http://localhost:3000
NUXT_PUBLIC_FIREBASE_API_KEY=[YOUR_FIREBASE_API_KEY]
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=[YOUR_PROJECT].firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=[YOUR_PROJECT_ID]
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=[YOUR_PROJECT].appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=[YOUR_SENDER_ID]
NUXT_PUBLIC_FIREBASE_APP_ID=[YOUR_APP_ID]
